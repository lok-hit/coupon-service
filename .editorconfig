root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json}]
indent_style = space
indent_size = 2

[*.gradle]
indent_style = space
indent_size = 4

[*.gradle.kts]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.xml]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
